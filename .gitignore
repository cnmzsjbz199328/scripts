node_modules/
dist/

# Generated experiment runs — track only registry and preview
pet_runs/**/*.png
pet_runs/**/*.webp
pet_runs/**/*.json
pet_runs/*/

# Generated texture runs — track only preview
texture_runs/**/*.png
texture_runs/**/*.webp
texture_runs/**/*.json
texture_runs/*/

# Generated character sprite runs
char_runs/**/*.png
char_runs/**/*.webp
char_runs/**/*.json
char_runs/*/

# Generated animated object runs
object_runs/**/*.png
object_runs/**/*.webp
object_runs/**/*.json
object_runs/*/

# Generated game project runs — track .html and .js source, ignore binaries
game_runs/**/*.json
!game_runs/games.json

# Track game assets so Cloudflare Pages CI can deploy them
!game_runs/**/*.png
!game_runs/**/*.webp

# ...except game-verify's transient interaction screenshots
game_runs/**/verify-screenshot.png

# ...and raw AI-generated intermediates (agy originals pre process-bg) — only the
# processed outputs next to them deploy; prompts to regenerate live in PROMPTS.md
game_runs/**/assets/**/raw/

# ...and superseded scene art kept locally as backup — unreferenced by any code,
# pure deploy dead weight if tracked
game_runs/**/scene/backup/

# game-playtest full playthrough recordings — local verification/showcase only,
# NOT version-controlled (large). The 10s preview.mp4 in each game root IS tracked.
game_runs/**/playtest/
game_runs/**/_rec/
# 专用 bot 的截图 + 报告（PokeMood 的 poke-bot 等），同属本地验证产物
game_runs/**/bot/
# 背景装配预检图（preview-bg.mjs / shot-scenes.mjs 的输出）—— 随时可重跑，纯本地目检用
game_runs/**/_bgcheck/

# showreel — concatenated demo video + all intermediate parts, local showcase only.
# Keep only the reproducible build script.
game_runs/_showreel/*
!game_runs/_showreel/build.sh

# scratch/ is a generator workspace — track .mjs/.ts/.js sources, ignore rendered artifacts
# 用 ** 覆盖子目录：单层 scratch/*.png 匹配不到 scratch/<run>/frame_01.png（inspect 抽帧就漏网过）
scratch/**/*.png
scratch/**/*.webp

# Video sprite runs — 源视频(外部AI生成,不可再生)+manifest(分段参数/scale,可复现抽帧)+test.html 入库；
# 抽出的帧 png 可由 process.ts 从 mp4+manifest 重放再生，不入库
video_runs/**/animations/
video_runs/**/output/

# AI tool workspaces
.gemini/

# FBX/GLB 角色素材库 — 大二进制不入库（inbox 待体检接入 / archive 已接入归档）
assets_fbx/

# BladeTrinity 原始素材 — 参考图 + 绿幕源视频，大二进制不入库
# 注意：game_runs/BladeTrinity/ 下的 webp/png/json 是成品图集，必须入库
#（Cloudflare CI 部署要读，见 CLAUDE.md 产物入库规则），不要在这里忽略
references/BladeTrinity/
# BladeTrinity 变身源片（Google Flow 生成的候选/验收 mp4）+ 由源片/参考图派生的审查图，
# 同属原始素材，不入库；只入库文字溯源（提示词 txt、审查 json、归档说明）。
# SHA-256 记在 plans/blade-trinity-transformation-integration-plan.md 与 transformation_candidates_*.md。
video_runs/sword/source/**/*.mp4
video_runs/sword/source/**/*.png
video_runs/water/source/**/*.mp4
video_runs/water/source/**/*.png
video_runs/north/source/**/*.mp4
video_runs/north/source/**/*.png
# 变身素材工作区：源片抽帧 / 抠图中间帧 / 审查接触表全部可由 build.mjs 从源片重放，不入库；
# 只入库构建脚本、元数据契约与审查报告（成品图集装进 game_runs/BladeTrinity/assets/sprites/transform/）
video_runs/BladeTrinityTransform/**/*.png
video_runs/BladeTrinityTransform/**/*.webp
video_runs/BladeTrinityTransform/**/*.mp4
video_runs/BladeTrinityTransform/*/work/

# PokeMood 独立站构建产物 —— 由 deploy/build.mjs 从仓库内文件重新组装，不入库
game_runs/PokeMood/dist/
