node_modules/
dist/

# Generated experiment runs — track only registry and preview
pet_runs/**/*.png
pet_runs/**/*.webp
pet_runs/**/*.json
pet_runs/*/

# Generated texture runs — track only preview
texture_runs/**/*.png
texture_runs/**/*.webp
texture_runs/**/*.json
texture_runs/*/

# Generated character sprite runs
char_runs/**/*.png
char_runs/**/*.webp
char_runs/**/*.json
char_runs/*/

# Generated animated object runs
object_runs/**/*.png
object_runs/**/*.webp
object_runs/**/*.json
object_runs/*/

# Generated game project runs — track .html and .js source, ignore binaries
game_runs/**/*.json
!game_runs/games.json

# Track game assets so Cloudflare Pages CI can deploy them
!game_runs/**/*.png
!game_runs/**/*.webp

# ...except game-verify's transient interaction screenshots
game_runs/**/verify-screenshot.png

# game-playtest full playthrough recordings — local verification/showcase only,
# NOT version-controlled (large). The 10s preview.mp4 in each game root IS tracked.
game_runs/**/playtest/
game_runs/**/_rec/

# showreel — concatenated demo video + all intermediate parts, local showcase only.
# Keep only the reproducible build script.
game_runs/_showreel/*
!game_runs/_showreel/build.sh

# scratch/ is a generator workspace — track .mjs/.ts/.js sources, ignore rendered artifacts
scratch/*.png
scratch/*.webp

# AI tool workspaces
.gemini/
